rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção usada pelo sistema de chamados SAC.
    // O app trava o acesso pelo token da API da Presença (nenhum dado é lido sem sessão válida),
    // mas o Firestore em si ainda aceita a chave pública do projeto.
    // Reforço recomendado: ativar o App Check no console do Firebase.
    match /reclamacoes/{documento} {
      allow read, write: if true;
    }

    // Configurações lidas pelo app (ex.: configuracoes/permissoesSac). Edição só pelo console.
    match /configuracoes/{documento} {
      allow read: if true;
    }

    // Anotações pessoais ("Minhas notas"), mesma política da coleção acima.
    match /notas_sac/{documento} {
      allow read, write: if true;
    }

    // Ouvidoria: a tela do SAC lê e grava direto (mesma política das coleções acima);
    // a ouvidoria-api grava no mesmo lugar com conta de serviço (ignora estas regras).
    match /ouvidoria_chamados/{documento=**} {
      allow read, write: if true;
    }
    // Sequência dos protocolos (ouvidoria_config/sequencia), usada pela tela e pela API.
    match /ouvidoria_config/{documento} {
      allow read, write: if true;
    }
    // Credenciais de terceiros (só o hash do segredo). Só a API acessa (rotas /api/admin).
    match /ouvidoria_clientes/{documento} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
